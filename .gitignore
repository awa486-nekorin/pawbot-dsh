# 依赖与产物（bundle 本身不需要 node_modules；它从宿主树解析）
node_modules/
pnpm-lock.yaml

# 备份/临时文件
*.before-*
*.bak
*.log
_scan*
_test*
diag-*.mjs

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# ── PawBot 本体（app/）的运行时数据与缓存：只让模板进库 ──
app/data/sessions.json
app/data/run.log
app/data/backup/
app/data/image_cache/
app/data/stickers/
app/data/browser/
app/data/people/*.md
app/data/diary/*.md
app/data/memory/entities.jsonl
app/data/*.before-*
app/data/*.bak
app/__pycache__/
app/**/__pycache__/
app/.venv/
*.pyc
app/data/napcat/
# B 站刷站（bili_scroll）产物与凭证：只留程式，不留资料
app/data/bili_notes/
app/data/bili_scroll_seen.json
app/pawbot/bili_mcp/bili_credential.json
app/pawbot/bili_mcp/.venv/
